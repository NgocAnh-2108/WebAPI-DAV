@using Hotel_Web.Models.DTO
@using Hotel_Web.Helpers
@model List<BookingWithDetailDTO>
@{
    ViewData["Title"] = "Kỳ nghỉ của tôi";
    string tab = ViewBag.Tab ?? "upcoming";
    string[] steps = { "Đặt phòng", "Thanh toán cọc", "Nhận phòng", "Trả phòng" };
    var usageMap = ViewBag.Usages as Dictionary<int, List<BookingServiceDTO>> ?? new();
}
<style>
    .mb-head { background: var(--espresso); color: #fff; padding: 150px 0 70px; text-align: center; }
    .mb-head h1 { font-size: clamp(42px, 6vw, 70px); font-weight: 500; margin-top: 10px; }
    .mb-head .eyebrow { color: var(--champagne); }
    .tabs { display: flex; justify-content: center; gap: 0; margin: -26px auto 50px; position: relative; z-index: 2; }
    .tabs a { background: #fff; padding: 16px 34px; text-decoration: none; font-size: 12px; letter-spacing: 3px; text-transform: uppercase; color: var(--muted); box-shadow: 0 10px 30px rgba(0,0,0,.08); }
    .tabs a.on { background: var(--gold); color: #fff; }
    .ticket { display: grid; grid-template-columns: 280px 1fr; background: #fff; margin-bottom: 34px; box-shadow: 0 20px 50px rgba(23,19,15,.07); }
    .ticket .stub { background: linear-gradient(160deg, #241d17, #3b2f24); color: #fff; padding: 34px 30px; position: relative; display: flex; flex-direction: column; justify-content: space-between; }
    .ticket .stub::after { content: ''; position: absolute; right: -10px; top: 0; bottom: 0; width: 20px;
                          background: radial-gradient(circle at 10px 12px, var(--ivory) 7px, transparent 8px) 0 0 / 20px 24px repeat-y; }
    .ticket .stub .lbl { font-size: 10px; letter-spacing: 3px; text-transform: uppercase; color: #b3a48f; }
    .ticket .stub .code { font-family: 'Courier New', monospace; font-size: 26px; font-weight: 700; color: var(--champagne); letter-spacing: 2px; margin-top: 6px; word-break: break-all; }
    .ticket .stub .hint { font-size: 12px; color: #b3a48f; font-weight: 300; margin-top: 12px; }
    .ticket .stub .status { display: inline-block; margin-top: 22px; padding: 7px 14px; border: 1px solid var(--champagne); font-size: 11px; letter-spacing: 2px; text-transform: uppercase; color: var(--champagne); }
    .ticket .main { padding: 34px 40px; }
    .ticket .rooms { font-family: var(--serif); font-size: 32px; font-weight: 500; }
    .dates { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 20px; margin: 20px 0 26px; padding: 20px 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
    .dates .d span { font-size: 10px; letter-spacing: 3px; text-transform: uppercase; color: var(--muted); }
    .dates .d b { display: block; font-family: var(--serif); font-size: 26px; font-weight: 500; }
    .dates .n { text-align: center; color: var(--gold); font-size: 12px; letter-spacing: 2px; text-transform: uppercase; }
    .dates .n::before, .dates .n::after { content: ''; display: inline-block; width: 30px; height: 1px; background: var(--gold); vertical-align: middle; margin: 0 8px; }
    .money { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
    .money span { font-size: 10px; letter-spacing: 3px; text-transform: uppercase; color: var(--muted); }
    .money b { display: block; font-family: var(--serif); font-size: 24px; font-weight: 600; }
    .progress { display: flex; margin: 28px 0 6px; }
    .progress div { flex: 1; text-align: center; font-size: 11px; letter-spacing: 1px; color: #b6aa99; position: relative; padding-top: 18px; }
    .progress div::before { content: ''; position: absolute; top: 4px; left: 0; right: 0; height: 2px; background: var(--line); }
    .progress div::after { content: ''; position: absolute; top: 0; left: 50%; width: 10px; height: 10px; margin-left: -5px; border-radius: 50%; background: var(--line); }
    .progress div.done { color: var(--ink); } .progress div.done::before, .progress div.done::after { background: var(--gold); }
    .t-actions { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 26px; }
    .svc-list { margin-top: 22px; background: var(--sand); padding: 16px 18px; font-size: 14px; }
    .svc-list > div:not(.eyebrow) { display: flex; justify-content: space-between; padding: 5px 0; border-bottom: 1px dashed #ddd2c2; }
    .svc-list em { color: var(--muted); font-size: 12px; margin-left: 6px; }
    .note { margin-top: 14px; font-size: 14px; color: var(--muted); font-style: italic; }
    .cancelled { opacity: .85; }
    .refund-form { display: grid; grid-template-columns: 1fr 1fr 1fr auto; gap: 8px; margin-top: 12px; align-items: center; }
    .refund-form .eyebrow { grid-column: 1 / -1; }
    .refund-form input, .refund-form select { padding: 10px 12px; border: 1px solid var(--line); background: #fff; font-family: var(--sans); font-size: 14px; min-width: 0; }
    @@media (max-width: 820px) { .refund-form { grid-template-columns: 1fr; } }
    .empty-state { text-align: center; padding: 60px 20px 20px; }
    .empty-state h3 { font-size: 34px; font-weight: 500; }
    .empty-state p { color: var(--muted); margin: 10px 0 26px; }
    @@media (max-width: 820px) { .ticket { grid-template-columns: 1fr; } .ticket .stub::after { display: none; } .money { grid-template-columns: 1fr; } }
</style>

<section class="mb-head">
    <div class="eyebrow">Hội viên DAV</div>
    <h1>Kỳ nghỉ của tôi</h1>
</section>

<div class="container" style="max-width:1040px">
    <div class="tabs">
        <a class="@(tab != "history" ? "on" : "")" href="?tab=upcoming">Sắp tới (@ViewBag.UpcomingCount)</a>
        <a class="@(tab == "history" ? "on" : "")" href="?tab=history">Lịch sử (@ViewBag.HistoryCount)</a>
    </div>

    @if (ViewBag.Error != null) { <p style="text-align:center;color:#a8443b">@ViewBag.Error</p> }

    @foreach (var b in Model)
    {
        var nights = (b.CheckOutDate.Date - b.CheckInDate.Date).Days;
        var paid = b.IsDepositPaid ? b.DepositAmount : 0;
        var used = usageMap.TryGetValue(b.Id, out var ul) ? ul : new List<BookingServiceDTO>();
        var svcTotal = used.Sum(u => u.Total);
        int stage = b.Status switch { "Pending" => 1, "Confirmed" => 2, "CheckedIn" => 3, "CheckedOut" => 4, _ => 0 };
        <div class="ticket reveal @(b.Status is "Cancelled" or "NoShow" ? "cancelled" : "")">
            <div class="stub">
                <div>
                    <div class="lbl">Mã booking</div>
                    <div class="code">@b.BookingCode</div>
                    <div class="hint">Xuất trình mã này tại quầy lễ tân để nhận phòng nhanh.</div>
                </div>
                <div><span class="status">@RoleHelper.StatusLabel(b.Status)</span></div>
            </div>
            <div class="main">
                <div class="eyebrow">Đặt ngày @b.CreatedDate.ToString("dd/MM/yyyy")</div>
                <div class="rooms">Phòng @string.Join(" · ", b.RoomNumbers)</div>
                <div class="dates">
                    <div class="d"><span>Nhận phòng</span><b>@b.CheckInDate.ToString("dd/MM/yyyy")</b><span>từ @b.CheckInDate.ToString("HH:mm")</span></div>
                    <div class="n">@nights đêm</div>
                    <div class="d" style="text-align:right"><span>Trả phòng</span><b>@b.CheckOutDate.ToString("dd/MM/yyyy")</b><span>trước @b.CheckOutDate.ToString("HH:mm")</span></div>
                </div>
                <div class="money">
                    <div><span>Tổng tiền phòng</span><b>@b.TotalPrice.ToString("N0")₫</b>@if (b.RoomChangeDiscount > 0) { <span style="color:#3d7a55">đã giảm @b.RoomChangeDiscount.ToString("N0")₫ do đổi phòng</span> }</div>
                    <div><span>Tiền cọc (30%)</span><b style="color:@(b.IsDepositPaid ? "#3d7a55" : "var(--gold)")">@b.DepositAmount.ToString("N0")₫</b><span>@(b.IsDepositPaid ? "Đã thanh toán" : "Chưa thanh toán")</span></div>
                    <div><span>Thanh toán khi trả phòng</span><b>@((b.TotalPrice + svcTotal - paid).ToString("N0"))₫</b>@if (svcTotal > 0) { <span>gồm dịch vụ @svcTotal.ToString("N0")₫</span> }</div>
                </div>

                @if (b.Status is "Cancelled" or "NoShow")
                {
                    <div class="svc-list" style="background:#f7efe9">
                        <div class="eyebrow" style="margin-bottom:6px">@(b.Status == "NoShow" ? "Không đến nhận phòng" : "Đã hủy") @(b.CancelledDate?.ToString("HH:mm dd/MM/yyyy"))</div>
                        @if (!string.IsNullOrEmpty(b.CancelReason)) { <div style="border:none"><span>@b.CancelReason</span></div> }
                        @if (b.IsDepositPaid)
                        {
                            <div><span>Khách sạn giữ lại</span><b>@b.CancellationFee.ToString("N0")₫</b></div>
                            <div><span>Hoàn lại cho bạn</span><b>@b.RefundAmount.ToString("N0")₫ @(b.RefundStatus == "Done" ? "· đã hoàn" : b.RefundStatus == "Pending" ? "· đang xử lý" : "")</b></div>
                        }
                        @if (b.RefundStatus == "Done")
                        {
                            <div><span>Đã hoàn lúc @b.RefundedDate?.ToString("HH:mm dd/MM/yyyy")</span><span>@b.RefundNote</span></div>
                        }
                        @if (b.RefundStatus == "Pending" && !string.IsNullOrEmpty(b.RefundAccountNumber))
                        {
                            <div><span>Nhận tiền vào</span><b>@BankHelper.Name(b.RefundBankCode) · @b.RefundAccountNumber · @b.RefundAccountName</b></div>
                        }
                    </div>
                    @if (b.RefundStatus == "Pending")
                    {
                        <form asp-action="SaveRefundAccount" method="post" class="refund-form">
                            <input type="hidden" name="bookingId" value="@b.Id" />
                            <div class="eyebrow">@(string.IsNullOrEmpty(b.RefundAccountNumber) ? "Khai báo tài khoản để nhận tiền hoàn" : "Sửa tài khoản nhận tiền hoàn")</div>
                            <select name="BankCode" required>
                                <option value="">Ngân hàng</option>
                                @foreach (var bk in BankHelper.Banks) { <option value="@bk.Code" selected="@(bk.Code == b.RefundBankCode)">@bk.Name</option> }
                            </select>
                            <input name="AccountNumber" required placeholder="Số tài khoản" value="@b.RefundAccountNumber" inputmode="numeric" pattern="\d{6,19}" maxlength="19" title="Chỉ nhập chữ số, từ 6 đến 19 số" oninput="this.value=this.value.replace(/\D/g,'')" />
                            <input name="AccountName" required placeholder="TÊN CHỦ TÀI KHOẢN" value="@b.RefundAccountName" style="text-transform:uppercase" pattern="[A-Za-zÀ-ỹĐđ ]{2,50}" maxlength="50" title="Chỉ nhập chữ cái và khoảng trắng" oninput="this.value=this.value.replace(/[^A-Za-zÀ-ỹĐđ ]/g,'')" />
                            <button class="btn-lux gold">Lưu</button>
                        </form>
                    }
                }
                else
                {
                    <div class="progress">
                        @for (int s = 0; s < steps.Length; s++) { <div class="@(s < stage ? "done" : "")">@steps[s]</div> }
                    </div>
                }
                @if (used.Any())
                {
                    <div class="svc-list">
                        <div class="eyebrow" style="margin-bottom:6px">Dịch vụ đã sử dụng</div>
                        @foreach (var u in used)
                        {
                            <div><span>@u.ServiceName · @u.Quantity @u.Unit <em>@u.UsedDate.ToString("dd/MM")</em></span><b>@u.Total.ToString("N0")₫</b></div>
                        }
                    </div>
                }
                @if (!string.IsNullOrEmpty(b.Note)) { <div class="note">Ghi chú: @b.Note</div> }

                <div class="t-actions">
                    @if (!b.IsDepositPaid && b.Status == "Pending")
                    {
                        <a class="btn-lux gold" href="/Bookings/Pay/@b.Id">Thanh toán cọc @b.DepositAmount.ToString("N0")₫</a>
                        <a class="btn-lux ghost" href="/Bookings/CancelConfirm/@b.Id">Hủy đặt phòng</a>
                    }
                    @if (b.Status == "Confirmed")
                    {
                        <span style="color:#3d7a55;font-size:14px;align-self:center">Phòng đã được giữ cho bạn. Hẹn gặp bạn lúc @b.CheckInDate.ToString("HH:mm") ngày @b.CheckInDate.ToString("dd/MM")!</span>
                        <a class="btn-lux ghost" href="/Bookings/CancelConfirm/@b.Id">Hủy đặt phòng</a>
                    }
                </div>
            </div>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="empty-state">
            <h3>@(tab == "history" ? "Chưa có kỳ nghỉ nào trong lịch sử" : "Bạn chưa có kỳ nghỉ sắp tới")</h3>
            <p>Hãy để chúng tôi chuẩn bị cho chuyến đi tiếp theo của bạn.</p>
            <a class="btn-lux" href="/Rooms/List">Khám phá phòng</a>
        </div>
    }
</div>
