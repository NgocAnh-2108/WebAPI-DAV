@using Hotel_Web.Models.DTO
@using Hotel_Web.Helpers
@model LoginDTO
@{
    ViewData["Title"] = "Đăng nhập";
}
<style>
    .auth { min-height: 100vh; display: grid; grid-template-columns: 1fr 1fr; }
    .auth .art { background: linear-gradient(160deg, #1c1712 0%, #3b2f24 60%, #5b4732 100%); color: #fff; display: flex; flex-direction: column; justify-content: center; padding: 140px 70px 70px; position: relative; overflow: hidden; }
    .auth .art::before { content: 'DAV'; position: absolute; right: -40px; bottom: -60px; font-family: var(--serif); font-size: 300px; color: rgba(217,185,138,.07); font-weight: 700; letter-spacing: 10px; }
    .auth .art h2 { font-size: 56px; font-weight: 500; line-height: 1.05; margin-top: 16px; animation: rise 1s ease both; }
    .auth .art h2 em { color: var(--champagne); }
    .auth .art p { color: #c9bca9; font-weight: 300; margin-top: 20px; max-width: 420px; animation: rise 1.2s ease both; }
    .auth .form { display: flex; align-items: center; justify-content: center; padding: 140px 40px 70px; }
    .auth .box { width: 100%; max-width: 420px; animation: rise 1s ease .15s both; }
    .auth .box h1 { font-size: 46px; font-weight: 500; }
    .auth .box form { display: grid; gap: 20px; margin-top: 34px; }
    .auth .err { background: #f8e9e7; color: #8f3a32; padding: 12px 16px; font-size: 14px; margin-top: 20px; }
    .auth .alt { margin-top: 26px; font-size: 14px; color: var(--muted); text-align: center; }
    .auth .alt a { color: var(--gold); }
    @@keyframes rise { from { opacity: 0; transform: translateY(24px); } to { opacity: 1; transform: none; } }
    @@media (max-width: 900px) { .auth { grid-template-columns: 1fr; } .auth .art { display: none; } }
</style>
<div class="auth">
    <div class="art">
        <div class="eyebrow" style="color:var(--champagne)">Chào mừng trở lại</div>
        <h2>Kỳ nghỉ của bạn<br />đang <em>chờ đợi</em></h2>
        <p>Đăng nhập để đặt phòng, thanh toán tiền cọc và quản lý mã booking của bạn. Nhân viên đăng nhập sẽ được chuyển tới trang quản trị.</p>
    </div>
    <div class="form">
        <div class="box">
            <div class="eyebrow">DAV Hotel &amp; Resort</div>
            <h1>Đăng nhập</h1>
            @if (ViewBag.Error != null) { <div class="err">@ViewBag.Error</div> }
            <form asp-action="Login" method="post">
                <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
                <div class="fld"><label>Email</label><input type="email" name="Username" value="@Model?.Username" required autofocus /></div>
                <div class="fld"><label>Mật khẩu</label><input type="password" name="Password" required /></div>
                <button type="submit" class="btn-lux block">Đăng nhập</button>
            </form>
            <div class="alt">Chưa có tài khoản? <a href="/Account/Register?returnUrl=@Uri.EscapeDataString((string?)ViewBag.ReturnUrl ?? "")">Đăng ký hội viên</a></div>
        </div>
    </div>
</div>
